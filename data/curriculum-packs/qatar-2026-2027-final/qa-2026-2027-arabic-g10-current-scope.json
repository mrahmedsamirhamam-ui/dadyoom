  "units": [
    {
      "number": 1,
      "title": "معايير اللغة العربية — تغطية العام الأكاديمي",
      "description": "حزمتا تغطية للمعايير الرسمية بحسب المجال والسنة الدراسية خلال الفصلين؛ ليستا أسماء وحدات أو دروس وزارية.",
      "lessons": [
        {
          "number": 1,
          "title": "حزمة تغطية ضاديوم لمعايير اللغة العربية — الفصل الدراسي الأول",
          "type": "assessment",
          "estimatedMinutes": 40,
          "summary": "حزمة أصلية من ضاديوم لتغطية معايير منهج اللغة العربية القطري للصف العاشر خلال الفصل الدراسي الأول على مستوى نواتج التعلم والمعايير، وليست عنوان درس وزاري.",
          "content": "هذه حزمة تعليمية أصلية من ضاديوم لمواءمة معايير اللغة العربية في دولة قطر للصف العاشر خلال الفصل الدراسي الأول من العام 2026-2027. تستند المواءمة إلى الإطار العام للمنهج الوطني ووثائق المعايير ومصادر التعلم التي تصدرها الوزارة، ولا تدّعي أن اسم هذه الحزمة عنوان درس أو وحدة في كتاب وزاري. يعمل المتعلم على فهم المقروء والمسموع والتعبير الشفهي والكتابي واستعمال اللغة بما يناسب مستواه، ثم يطبق المهارة في سياق جديد ويراجع أداءه بمعيار واضح. عند الحاجة إلى نص الكتاب الأصلي يستخدم الطالب نسخته الوزارية أو المصدر المرخص ولا يعاد نشر النص داخل ضاديوم.",
          "objectives": [
            "أن يفسر المتعلم ناتج تعلم لغوي مناسبًا للصف العاشر في الفصل الدراسي الأول بلغته الخاصة.",
            "أن يطبق المتعلم مهارة لغوية من معايير الصف العاشر في موقف جديد.",
            "أن يراجع المتعلم أداءه اللغوي ويحدد دليلًا على الإتقان أو موضعًا يحتاج إلى تحسين."
          ],
          "vocabulary": [
            {
              "word": "معيار",
              "meaning": "وصف واضح لما يتوقع من المتعلم أن يعرفه أو يستطيع أداءه."
            },
            {
              "word": "ناتج تعلم",
              "meaning": "أداء أو معرفة متوقعة بعد خبرة تعليمية."
            },
            {
              "word": "كفاية",
              "meaning": "توظيف المعرفة والمهارة والاتجاه في موقف ذي معنى."
            }
          ],
          "questions": [
            {
              "question": "ما أفضل طريقة للعمل مع معايير اللغة العربية في الفصل الدراسي الأول؟",
              "type": "multiple_choice",
              "options": [
                {
                  "id": "a",
                  "text": "أفهم المطلوب ثم أطبقه في مثال جديد."
                },
                {
                  "id": "b",
                  "text": "أحفظ عنوانًا فقط."
                },
                {
                  "id": "c",
                  "text": "أتجاوز التطبيق."
                }
              ],
              "correctAnswer": "a",
              "explanation": "المعيار يقاس بأداء قابل للملاحظة والتطبيق.",
              "points": 1
            },
            {
              "question": "ما الدليل الأقوى على تحقق ناتج التعلم؟",
              "type": "multiple_choice",
              "options": [
                {
                  "id": "a",
                  "text": "أداء مستقل مع تفسير أو شاهد."
                },
                {
                  "id": "b",
                  "text": "نسخ إجابة جاهزة."
                },
                {
                  "id": "c",
                  "text": "تكرار السؤال."
                }
              ],
              "correctAnswer": "a",
              "explanation": "الأداء المستقل يبين تحقق ناتج التعلم.",
              "points": 1
            },
            {
              "question": "كيف يستخدم الطالب مصدر الوزارة مع ضاديوم؟",
              "type": "multiple_choice",
              "options": [
                {
                  "id": "a",
                  "text": "يقرأ النص من المصدر المرخص ويستخدم ضاديوم للفهم والتطبيق والتقييم."
                },
                {
                  "id": "b",
                  "text": "يستبدل الكتاب بنسخة منسوخة كاملة."
                },
                {
                  "id": "c",
                  "text": "يهمل المصدر الرسمي."
                }
              ],
              "correctAnswer": "a",
              "explanation": "ضاديوم يكمّل المصدر الرسمي بمحتوى أصلي ولا يعيد نشره.",
              "points": 1
            }
          ],
