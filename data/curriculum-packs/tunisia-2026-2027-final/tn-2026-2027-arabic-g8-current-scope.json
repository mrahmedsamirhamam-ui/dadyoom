      "lessons": [
        {
          "number": 1,
          "title": "اللغة العربية — السنة 8 أساسي — حزمة الكتاب الرسمي",
          "type": "reading",
          "estimatedMinutes": 40,
          "summary": "حزمة وطنية أصلية لمواءمة العربية في السنة 8 أساسي مع الكتب الرسمية التونسية.",
          "content": "تمثل هذه العقدة «اللغة العربية — السنة 8 أساسي — حزمة الكتاب الرسمي» وحدة مطابقة وطنية على مستوى السنة الدراسية في النظام التونسي. يعلن المركز الوطني البيداغوجي الكتب المدرسية الرسمية للسنة 2026-2027، وتنشر وزارة التربية القوائم المطلوبة للمراحل الابتدائية والإعدادية والثانوية بما يشمل السنوات الأربع للتعليم الثانوي. يقدم ضاديوم تعلمًا أصليًا في القراءة والفهم والتعبير والقواعد والمفردات، من دون إعادة نشر النصوص المحمية أو اختلاق عناوين وحدات غير موثقة.",
          "objectives": [
            "أن يفسر المتعلم متطلبات العربية في السنة 8 أساسي.",
            "أن يطبق مهارة قراءة أو لغة أو تعبير في موقف جديد.",
            "أن يراجع أداءه ويصححه وفق معيار واضح."
          ],
          "vocabulary": [
            {
              "word": "قراءة",
              "meaning": "فهم النص وتحليل معناه وبنيته."
            },
            {
              "word": "تعبير",
              "meaning": "إنتاج شفهي أو كتابي يحقق غرضًا تواصليًا."
            },
            {
              "word": "لغة",
              "meaning": "المفردات والتراكيب والقواعد المنظمة للاستعمال."
            }
