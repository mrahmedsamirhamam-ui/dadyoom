      "lessons": [
        {
          "number": 1,
          "title": "اللغة العربية — Terminale — سلسلة L",
          "type": "reading",
          "estimatedMinutes": 40,
          "summary": "حزمة وطنية أصلية من ضاديوم للعربية في اللغة العربية — Terminale — سلسلة L.",
          "content": "تمثل هذه العقدة «اللغة العربية — Terminale — سلسلة L» وحدة مطابقة وطنية وفق برامج CRIPEN الرسمية للسنة النهائية، مع مراعاة سلسلة L. توثق المصادر الرسمية استمرار العربية في السلاسل L وES وS وSG ووجود امتحانات بكالوريا رسمية في العربية، بينما يقدم ضاديوم محتوى أصليًا ولا يعيد نشر النصوص المحمية. يعمل المتعلم على الفهم والتحليل والتعبير والتراكيب بما يناسب السلسلة، ثم يراجع أداءه وفق معيار واضح.",
          "objectives": [
            "أن يفسر متطلبات تعلم العربية في اللغة العربية — Terminale — سلسلة L.",
            "أن يطبق مهارة لغوية أو أدبية في موقف جديد.",
            "أن يراجع إنتاجه ويصححه وفق معيار."
          ],
          "vocabulary": [
            {
              "word": "كفاءة",
              "meaning": "قدرة على توظيف المعارف والمهارات."
            },
            {
              "word": "تواصل",
              "meaning": "نقل المعنى وفهمه عبر مهارات اللغة."
            },
            {
              "word": "نص",
              "meaning": "بناء لغوي مترابط يحمل معنى."
            }
          ],
          "questions": [
            {
              "question": "ما وظيفة هذه الحزمة؟",
              "type": "multiple_choice",
              "options": [
                {
                  "id": "a",
                  "text": "مواءمة السلسلة الرسمية بمحتوى أصلي."
                },
                {
                  "id": "b",
                  "text": "نسخ الكتاب كاملًا."
                },
                {
                  "id": "c",
                  "text": "اختراع سلسلة."
                }
