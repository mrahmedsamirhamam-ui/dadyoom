      "lessons": [
        {
          "number": 1,
          "title": "اللغة العربية — Première — سلسلة L",
          "type": "reading",
          "estimatedMinutes": 40,
          "summary": "حزمة وطنية أصلية من ضاديوم لمواءمة العربية في اللغة العربية — Première — سلسلة L مع المصادر الرسمية الجيبوتية.",
          "content": "تمثل هذه العقدة «اللغة العربية — Première — سلسلة L» وحدة مطابقة وطنية مبنية على أدلة ومناهج MENFOP وCRIPEN. في التعليم الأساسي تُستخدم الحزمة على مستوى السنة والمقرر، وفي الثانوي تُراعى السلاسل L وES وS وSG كما توثق البرامج الرسمية. يقدم ضاديوم شرحًا وأمثلة وأسئلة وأنشطة أصلية ولا يعيد نشر النصوص المحمية. يعمل المتعلم على الفهم والتواصل والقراءة والكتابة والمفردات والتراكيب المناسبة لمستواه، ثم يراجع أداءه وفق معيار واضح. عند الحاجة إلى نص مقرر يستخدم المتعلم المصدر الرسمي أو نسخته المرخصة.",
          "objectives": [
            "أن يفسر المتعلم متطلبات تعلم العربية في «اللغة العربية — Première — سلسلة L».",
            "أن يطبق المتعلم مهارة لغوية في موقف جديد مناسب للمستوى.",
            "أن يراجع المتعلم إنتاجه اللغوي ويصححه اعتمادًا على دليل أو معيار."
          ],
          "vocabulary": [
            {
              "word": "كفاءة",
              "meaning": "قدرة على توظيف المعارف والمهارات في موقف دال."
            },
            {
              "word": "تواصل",
              "meaning": "نقل المعنى وفهمه عبر مهارات اللغة."
            },
            {
              "word": "نص",
              "meaning": "بناء لغوي مترابط يحمل معنى وغرضًا."
            }
          ],
          "questions": [
            {
              "question": "ما الاستخدام الصحيح لهذه الحزمة؟",
              "type": "multiple_choice",
              "options": [
                {
                  "id": "a",
                  "text": "مواءمة المقرر الرسمي بمحتوى ضاديوم أصلي."
                },
                {
                  "id": "b",
                  "text": "نسخ الدليل الرسمي كاملًا."
                },
                {
                  "id": "c",
                  "text": "اختراع مقرر مستقل."
                }
              ],
              "correctAnswer": "a",
              "explanation": "الحزمة تربط النطاق الرسمي بتعلم أصلي.",
              "points": 1
            },
            {
              "question": "ما الدليل الأقوى على الإتقان؟",
              "type": "multiple_choice",
              "options": [
                {
                  "id": "a",
                  "text": "تطبيق مستقل مع تفسير أو شاهد."
                },
