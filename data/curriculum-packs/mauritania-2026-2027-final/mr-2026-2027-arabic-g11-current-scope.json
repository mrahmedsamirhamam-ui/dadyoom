  "units": [
    {
      "number": 1,
      "title": "اللغة العربية — حزم الكتب الرسمية",
      "description": "السنة 5 ثانوي: تغطية الكتاب الرسمي والمسار عند وجوده.",
      "lessons": [
        {
          "number": 1,
          "title": "اللغة العربية — السنة 5 ثانوي — الشعبة الأدبية — حزمة الكتاب الرسمي",
          "type": "reading",
          "estimatedMinutes": 40,
          "summary": "حزمة وطنية أصلية من ضاديوم لمواءمة كتاب اللغة العربية الرسمي في السنة 5 ثانوي — الشعبة الأدبية بموريتانيا.",
          "content": "تمثل هذه العقدة «اللغة العربية — السنة 5 ثانوي — الشعبة الأدبية» وحدة مطابقة وطنية على مستوى الكتاب الرسمي المنشور عبر مبادرة كُتبي التي أطلقها المعهد التربوي الوطني وتضم الموارد التعليمية الرسمية المعتمدة. يعتمد ضاديوم أيضًا على وزارة التربية وإصلاح النظام التعليمي لتثبيت الإصلاح الجاري ومكانة العربية والتحضير للعام الدراسي 2026-2027. في التعليم الابتدائي والإعدادي تغطي الحزمة القراءة والكتابة والفهم والتعبير والقواعد. وفي السنوات الخامسة والسادسة والسابعة من الثانوي تُفصل الحزمة بين الشعبة الأدبية والشعبة العلمية كما يظهر في الكتب الرسمية الحالية. المحتوى والشروح والأسئلة والأنشطة أصلية لضاديوم ولا تعيد نشر نصوص الكتب المحمية.",
          "objectives": [
            "أن يحدد المتعلم الكفاءات اللغوية المستهدفة في السنة 5 ثانوي — الشعبة الأدبية.",
            "أن يطبق المتعلم مهارة قراءة أو قواعد أو تعبير في موقف جديد.",
            "أن يراجع المتعلم أداءه ويصححه اعتمادًا على معيار واضح."
          ],
          "vocabulary": [
            {
              "word": "قراءة",
              "meaning": "فهم النص وتحليل معناه."
            },
            {
              "word": "تعبير",
              "meaning": "إنتاج لغوي شفهي أو كتابي يحقق غرضًا واضحًا."
            },
            {
              "word": "قواعد",
              "meaning": "أنظمة تضبط بناء الكلمات والجمل واستعمالها."
            }
          ],
          "questions": [
            {
              "question": "ما وظيفة الحزمة داخل ضاديوم؟",
              "type": "multiple_choice",
              "options": [
                {
                  "id": "a",
                  "text": "مواءمة الكتاب الرسمي بمحتوى ضاديوم أصلي."
                },
                {
                  "id": "b",
                  "text": "نسخ الكتاب كاملًا."
                },
                {
                  "id": "c",
                  "text": "اختراع مقرر جديد."
                }
              ],
              "correctAnswer": "a",
              "explanation": "الحزمة تربط الكتاب الرسمي بتعلم أصلي.",
              "points": 1
            },
            {
              "question": "ما الدليل الأقوى على الإتقان؟",
              "type": "multiple_choice",
              "options": [
                {
                  "id": "a",
                  "text": "تطبيق مستقل مع تفسير أو شاهد."
                },
                {
                  "id": "b",
                  "text": "حفظ اسم الكتاب."
                },
                {
                  "id": "c",
                  "text": "نسخ إجابة جاهزة."
                }
              ],
              "correctAnswer": "a",
              "explanation": "الإتقان يظهر في الأداء المستقل.",
              "points": 1
            },
            {
              "question": "كيف تراجع عملك؟",
              "type": "multiple_choice",
              "options": [
                {
                  "id": "a",
                  "text": "أقارن الناتج بالمعيار وأصحح."
                },
                {
                  "id": "b",
                  "text": "لا أراجع."
                },
                {
                  "id": "c",
                  "text": "أغير الإجابة عشوائيًا."
                }
              ],
              "correctAnswer": "a",
              "explanation": "المراجعة وفق معيار تحسن الأداء.",
              "points": 1
            }
          ],
