  "units": [
    {
      "number": 1,
      "title": "مقرر اللغة العربية — تغطية الفصلين",
      "description": "تغطية ضاديوم لمقرر اللغة العربية في الفصلين وفق النطاق الرسمي المتاح.",
      "lessons": [
        {
          "number": 1,
          "title": "اللغة العربية — الفصل الدراسي الأول — حزمة نواتج التعلم",
          "type": "assessment",
          "estimatedMinutes": 40,
          "summary": "حزمة مطابقة وطنية أصلية لمقرر اللغة العربية في الصف 11 للفصل الدراسي 1 ضمن النطاق الرسمي المنشور والقابل للتحقق.",
          "content": "يمثل هذا العنصر حزمة نواتج تعلم للمقرر الوطني «اللغة العربية» للصف 11 في الفصل الدراسي 1، وهو ليس عنوان درس وزاري مخترعًا. اعتمدت ضاديوم هذه الوحدة عندما لا تتيح الواجهة العامة للوزارة تسلسل عناوين وحدات ودروس الثانوية بصورة قابلة للتدقيق، مع استمرار إثبات المقرر عبر مكتبة الطالب الرسمية، التقويم التربوي، وأخبار تطبيق المناهج والثانوية. تقدم ضاديوم شرحًا وتطبيقًا وتقويمًا أصليًا يغطي القراءة والتحليل واللغة والكتابة والتواصل، ويستخدم Core كحزمة مهارات مساندة فقط. في الصف العاشر يشمل ذلك النظام الثانوي القائم وتجربة المسارات حيث اللغة العربية مقرر عام مشترك في المرحلة التأسيسية.",
          "objectives": [
            "أن يطبق المتعلم نواتج تعلم اللغة العربية للصف 11 في الفصل 1 عبر قراءة ولغة وكتابة متكاملة.",
            "أن يحلل المتعلم نصًا أو موقفًا لغويًا مناسبًا لمستواه ويبرر استجابته.",
            "أن يراجع المتعلم إنتاجه اللغوي ويصححه وفق معايير الدقة والترابط."
          ],
          "vocabulary": [
            {
              "word": "ناتج تعلم",
              "meaning": "أداء متوقع يمكن ملاحظته وقياسه بعد التعلم."
            },
            {
              "word": "تحليل",
              "meaning": "تفكيك النص أو التركيب لفهم عناصره وعلاقاته."
            },
            {
              "word": "ترابط",
              "meaning": "اتصال الأفكار والجمل في تسلسل منطقي."
            }
          ],
          "questions": [
            {
              "question": "ما المقصود بهذه الحزمة؟",
