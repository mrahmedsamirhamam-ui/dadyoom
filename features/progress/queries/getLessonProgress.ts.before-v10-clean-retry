import { createClient } from "@/lib/supabase/server";

export async function getLessonProgress(
  lessonId: string
) {
  const supabase =
    await createClient();

  console.time(
    "LESSON_PROGRESS_AUTH"
  );

  const {
    data: { user },
  } =
    await supabase.auth.getUser();

  console.timeEnd(
    "LESSON_PROGRESS_AUTH"
  );

  if (!user) {
    return {
      user: null,
      completed: false,
    };
  }

  console.time(
    "LESSON_PROGRESS_QUERY"
  );

  const { data } =
    await supabase
      .from("lesson_progress")
      .select("completed")
      .eq(
        "user_id",
        user.id
      )
      .eq(
        "lesson_id",
        lessonId
      )
      .maybeSingle();

  console.timeEnd(
    "LESSON_PROGRESS_QUERY"
  );

  return {
    user,
    completed:
      data?.completed ?? false,
  };
}