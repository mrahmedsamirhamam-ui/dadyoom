import { createClient } from "@/lib/supabase/server";

export async function getLessonById(
  id: string
) {
  const supabase = await createClient();

  const { data: lesson, error } =
    await supabase
      .from("lessons")
      .select("*")
      .eq("id", id)
      .eq("status", "published")
      .maybeSingle();

  if (error) {
    console.error(
      "Failed to load lesson:",
      error
    );

    throw error;
  }

  if (!lesson) {
    return null;
  }

  const { data: previousLesson } =
    await supabase
      .from("lessons")
      .select("id,title,lesson_number")
      .eq("unit_id", lesson.unit_id)
      .eq("status", "published")
      .lt(
        "lesson_number",
        lesson.lesson_number
      )
      .order("lesson_number", {
        ascending: false,
      })
      .limit(1)
      .maybeSingle();

  const { data: nextLesson } =
    await supabase
      .from("lessons")
      .select("id,title,lesson_number")
      .eq("unit_id", lesson.unit_id)
      .eq("status", "published")
      .gt(
        "lesson_number",
        lesson.lesson_number
      )
      .order("lesson_number", {
        ascending: true,
      })
      .limit(1)
      .maybeSingle();

  return {
    ...lesson,
    previousLesson:
      previousLesson ?? null,
    nextLesson:
      nextLesson ?? null,
  };
}