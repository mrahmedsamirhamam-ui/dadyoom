"use client";

import {
  useMemo,
  useState,
} from "react";

type LessonActivity = {
  id: string;
  title: string;
  activity_type: string;
  instructions: string | null;
  content: Record<string, unknown>;
  activity_order: number;
  points: number;
  section: string;
};

type Props = {
  activities: LessonActivity[];
};

type CheckResult = {
  correct: boolean;
  earnedPoints: number;
  maxPoints: number;
};

type ApiResult = {
  success: boolean;
  correct?: boolean;
  earnedPoints?: number;
  maxPoints?: number;
  message?: string;
};

function stringArray(
  value: unknown
): string[] {
  return Array.isArray(value)
    ? value.filter(
        (item): item is string =>
          typeof item === "string"
      )
    : [];
}

export default function InteractiveLessonActivities({
  activities,
}: Props) {

  const sortedActivities =
    useMemo(
      () =>
        [...activities].sort(
          (a, b) =>
            a.activity_order -
            b.activity_order
        ),
      [activities]
    );

  const [
    selectedAnswers,
    setSelectedAnswers,
  ] =
    useState<
      Record<string, string[]>
    >({});

  const [
    results,
    setResults,
  ] =
    useState<
      Record<string, CheckResult>
    >({});

  const [
    checking,
    setChecking,
  ] =
    useState<
      Record<string, boolean>
    >({});

  const [
    errors,
    setErrors,
  ] =
    useState<
      Record<string, string>
    >({});


  function toggleOption(
    activityId: string,
    option: string
  ) {
    setResults(
      (current) => {
        const next = {
          ...current,
        };

        delete next[
          activityId
        ];

        return next;
      }
    );

    setErrors(
      (current) => ({
        ...current,
        [activityId]: "",
      })
    );

    setSelectedAnswers(
      (current) => {

        const selected =
          current[
            activityId
          ] ?? [];

        const exists =
          selected.includes(
            option
          );

        return {
          ...current,

          [activityId]:
            exists
              ? selected.filter(
                  (item) =>
                    item !==
                    option
                )
              : [
                  ...selected,
                  option,
                ],
        };
      }
    );
  }


  async function checkActivity(
    activityId: string
  ) {

    const answer =
      selectedAnswers[
        activityId
      ] ?? [];

    if (
      answer.length === 0
    ) {
      setErrors(
        (current) => ({
          ...current,
          [activityId]:
            "اختر إجابة أولًا.",
        })
      );

      return;
    }

    try {

      setChecking(
        (current) => ({
          ...current,
          [activityId]:
            true,
        })
      );

      setErrors(
        (current) => ({
          ...current,
          [activityId]:
            "",
        })
      );

      const response =
        await fetch(
          "/api/lesson-activities/check",
          {
            method:
              "POST",

            headers: {
              "Content-Type":
                "application/json",
            },

            body:
              JSON.stringify({
                activityId,
                answer,
              }),
          }
        );

      const data =
        (await response.json()) as ApiResult;

      if (
        !response.ok ||
        !data.success
      ) {
        throw new Error(
          data.message ??
          "تعذر تصحيح النشاط."
        );
      }

      setResults(
        (current) => ({
          ...current,

          [activityId]: {
            correct:
              Boolean(
                data.correct
              ),

            earnedPoints:
              Number(
                data.earnedPoints ??
                0
              ),

            maxPoints:
              Number(
                data.maxPoints ??
                0
              ),
          },
        })
      );

    } catch (error) {

      setErrors(
        (current) => ({
          ...current,

          [activityId]:
            error instanceof Error
              ? error.message
              : "حدث خطأ أثناء التصحيح.",
        })
      );

    } finally {

      setChecking(
        (current) => ({
          ...current,
          [activityId]:
            false,
        })
      );
    }
  }


  const totalEarned =
    Object.values(
      results
    ).reduce(
      (
        total,
        result
      ) =>
        total +
        result.earnedPoints,
      0
    );

  const totalChecked =
    Object.keys(
      results
    ).length;


  return (
    <section className="rounded-3xl bg-white p-6 shadow-sm">

      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">

        <div>

          <p className="text-sm font-black text-violet-700">
            🎮 الأنشطة التفاعلية
          </p>

          <h2 className="mt-1 text-2xl font-black text-slate-900">
            تدرب خطوة بخطوة
          </h2>

        </div>

        <div className="flex flex-wrap gap-2">

          <span className="rounded-full bg-violet-50 px-4 py-2 text-sm font-black text-violet-700">
            {
              sortedActivities.length
            } نشاط
          </span>

          {totalChecked > 0 ? (
            <span className="rounded-full bg-emerald-50 px-4 py-2 text-sm font-black text-emerald-700">
              ⭐ {totalEarned} نقطة
            </span>
          ) : null}

        </div>

      </div>


      <div className="mt-6 space-y-5">

        {sortedActivities.map(
          (
            activity,
            index
          ) => {

            const content =
              activity.content ??
              {};

            const options =
              stringArray(
                content.options
              );

            const words =
              stringArray(
                content.words
              );

            const questions =
              stringArray(
                content.questions
              );

            const examples =
              stringArray(
                content.examples
              );

            const selected =
              selectedAnswers[
                activity.id
              ] ?? [];

            const result =
              results[
                activity.id
              ];

            const error =
              errors[
                activity.id
              ];

            const isChecking =
              checking[
                activity.id
              ] ?? false;

            const sectionLabel =
              activity.section ||
              (
                activity.activity_type ===
                "listening"
                  ? "الاستماع"

                  : activity.activity_type ===
                      "speaking"
                    ? "التحدث"

                    : activity.activity_type ===
                        "reading"
                      ? "القراءة"

                      : activity.activity_type ===
                          "writing"
                        ? "الكتابة"

                        : activity.activity_type ===
                            "matching"
                          ? "التدريب"

                          : activity.activity_type ===
                              "fill_blank"
                            ? "التدريب اللغوي"

                            : "نشاط"
              );


            return (
              <article
                key={
                  activity.id
                }
                className="rounded-2xl border border-slate-200 bg-slate-50 p-5"
              >

                <div className="flex gap-4">

                  <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-violet-600 text-sm font-black text-white">
                    {index + 1}
                  </span>

                  <div className="min-w-0 flex-1">

                    <div className="flex flex-wrap items-center gap-2">

                      <span className="rounded-full bg-violet-100 px-3 py-1 text-xs font-black text-violet-700">
                        {sectionLabel}
                      </span>

                      <span className="rounded-full bg-white px-3 py-1 text-xs font-bold text-slate-500 ring-1 ring-slate-200">
                        {
                          activity.points
                        } نقطة
                      </span>

                    </div>

                    <h3 className="mt-3 text-lg font-black text-slate-900">
                      {
                        activity.title
                      }
                    </h3>

                    {activity.instructions ? (
                      <p className="mt-2 leading-7 text-slate-600">
                        {
                          activity.instructions
                        }
                      </p>
                    ) : null}

                  </div>

                </div>


                {questions.length > 0 ? (
                  <div className="mt-5 space-y-2 rounded-xl bg-white p-4 ring-1 ring-slate-200">

                    {questions.map(
                      (
                        question,
                        questionIndex
                      ) => (
                        <p
                          key={`${activity.id}-q-${questionIndex}`}
                          className="leading-7 text-slate-700"
                        >
                          {
                            questionIndex +
                            1
                          }.{" "}
                          {question}
                        </p>
                      )
                    )}

                  </div>
                ) : null}


                {options.length > 0 ? (
                  <>

                    <div className="mt-5 grid gap-3 sm:grid-cols-2">

                      {options.map(
                        (
                          option,
                          optionIndex
                        ) => {

                          const active =
                            selected.includes(
                              option
                            );

                          return (
                            <button
                              key={`${activity.id}-option-${optionIndex}`}
                              type="button"
                              onClick={() =>
                                toggleOption(
                                  activity.id,
                                  option
                                )
                              }
                              className={
                                "rounded-xl border px-4 py-3 text-right font-bold transition " +
                                (
                                  active
                                    ? "border-violet-500 bg-violet-100 text-violet-900"
                                    : "border-slate-200 bg-white text-slate-700 hover:border-violet-300 hover:bg-violet-50"
                                )
                              }
                            >
                              {option}
                            </button>
                          );
                        }
                      )}

                    </div>


                    <button
                      type="button"
                      disabled={
                        isChecking
                      }
                      onClick={() =>
                        checkActivity(
                          activity.id
                        )
                      }
                      className="mt-4 rounded-xl bg-violet-600 px-5 py-3 font-black text-white transition hover:bg-violet-700 disabled:cursor-not-allowed disabled:opacity-60"
                    >
                      {
                        isChecking
                          ? "جاري التصحيح..."
                          : "تحقق من الإجابة"
                      }
                    </button>


                    {result ? (
                      <div
                        className={
                          "mt-4 rounded-xl p-4 font-black " +
                          (
                            result.correct
                              ? "bg-emerald-50 text-emerald-700"
                              : "bg-rose-50 text-rose-700"
                          )
                        }
                      >

                        {
                          result.correct
                            ? `✅ أحسنت! حصلت على ${result.earnedPoints} من ${result.maxPoints} نقطة.`
                            : "❌ حاول مرة أخرى."
                        }

                      </div>
                    ) : null}


                    {error ? (
                      <p className="mt-3 font-bold text-rose-600">
                        {error}
                      </p>
                    ) : null}

                  </>
                ) : null}


                {words.length > 0 ? (
                  <div className="mt-5 flex flex-wrap gap-2">

                    {words.map(
                      (
                        word,
                        wordIndex
                      ) => (
                        <span
                          key={`${activity.id}-word-${wordIndex}`}
                          className="rounded-xl bg-white px-4 py-2 font-black text-slate-800 ring-1 ring-slate-200"
                        >
                          {word}
                        </span>
                      )
                    )}

                  </div>
                ) : null}


                {examples.length > 0 ? (
                  <div className="mt-5 flex flex-wrap gap-2">

                    {examples.map(
                      (
                        example,
                        exampleIndex
                      ) => (
                        <span
                          key={`${activity.id}-example-${exampleIndex}`}
                          className="rounded-xl bg-violet-50 px-4 py-2 text-lg font-black text-violet-800"
                        >
                          {example}
                        </span>
                      )
                    )}

                  </div>
                ) : null}


                {activity.activity_type ===
                "writing" ? (
                  <div className="mt-5 rounded-2xl border-2 border-dashed border-violet-200 bg-white p-6 text-center">

                    <p className="text-sm font-bold text-slate-500">
                      ✍️ مساحة تدريب الكتابة
                    </p>

                    <div className="mt-4 text-7xl font-black text-violet-700">
                      {
                        typeof content.letter ===
                        "string"
                          ? content.letter
                          : "ب"
                      }
                    </div>

                  </div>
                ) : null}

              </article>
            );
          }
        )}

      </div>

    </section>
  );
}
