"use client";

import ListenButton from "@/features/lesson-activities/components/ListenButton";

import HandwritingCanvas from "@/features/lesson-activities/components/HandwritingCanvas";

import {
  useMemo,
  useState,
} from "react";

type LessonActivity = {
  id: string;
  title: string;
  activity_type: string;
  instructions: string | null;
  content: Record<string, unknown>;
  activity_order: number;
  points: number;
  section: string;
};

type Props = {
  activities: LessonActivity[];
};

type Result = {
  correct: boolean;
  earnedPoints: number;
  maxPoints: number;
  completionOnly?: boolean;
  progressPercent?: number;
  lessonScore?: number;
};

type ApiResult = {
  success: boolean;
  correct?: boolean;
  earnedPoints?: number;
  maxPoints?: number;
  completionOnly?: boolean;
  progressPercent?: number;
  lessonScore?: number;
  message?: string;
};

type FillItem = {
  sentence: string;
  options: string[];
};

function strings(value: unknown): string[] {
  return Array.isArray(value)
    ? value.filter(
        (item): item is string =>
          typeof item === "string"
      )
    : [];
}

function getFillItems(
  value: unknown
): FillItem[] {
  if (!Array.isArray(value)) {
    return [];
  }

  return value
    .map((item) => {
      if (
        typeof item !== "object" ||
        item === null ||
        Array.isArray(item)
      ) {
        return null;
      }

      const row =
        item as Record<string, unknown>;

      if (
        typeof row.sentence !== "string"
      ) {
        return null;
      }

      return {
        sentence:
          row.sentence,

        options:
          strings(
            row.options
          ),
      };
    })
    .filter(
      (item): item is FillItem =>
        item !== null
    );
}

const T = {
  activities:
    "\u0627\u0644\u0623\u0646\u0634\u0637\u0629 \u0627\u0644\u062a\u0641\u0627\u0639\u0644\u064a\u0629",

  train:
    "\u062a\u062f\u0631\u0628 \u062e\u0637\u0648\u0629 \u0628\u062e\u0637\u0648\u0629",

  activity:
    "\u0646\u0634\u0627\u0637",

  points:
    "\u0646\u0642\u0637\u0629",

  check:
    "\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0625\u062c\u0627\u0628\u0629",

  checking:
    "\u062c\u0627\u0631\u064a \u0627\u0644\u062a\u0635\u062d\u064a\u062d...",

  completeFirst:
    "\u0623\u0643\u0645\u0644 \u0627\u0644\u0646\u0634\u0627\u0637 \u0623\u0648\u0644\u0627\u064b.",

  completed:
    "\u062a\u0645 \u0627\u0644\u0646\u0634\u0627\u0637",

  markComplete:
    "\u062a\u0645\u0645\u062a \u0627\u0644\u0646\u0634\u0627\u0637",

  progress:
    "\u062a\u0642\u062f\u0645 \u0627\u0644\u062f\u0631\u0633",

  chooseMatch:
    "\u0627\u062e\u062a\u0631 \u0627\u0644\u0645\u0637\u0627\u0628\u0642\u0629",

  checkMatch:
    "\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0645\u0637\u0627\u0628\u0642\u0629",

  reset:
    "\u0625\u0639\u0627\u062f\u0629",

  checkOrder:
    "\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u062a\u0631\u062a\u064a\u0628",

  orderedPrompt:
    "\u0627\u0636\u063a\u0637 \u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0628\u0627\u0644\u062a\u0631\u062a\u064a\u0628:",

  emptyOrder:
    "\u0644\u0645 \u062a\u062e\u062a\u0631 \u0643\u0644\u0645\u0627\u062a \u0628\u0639\u062f",

  checkAnswers:
    "\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0625\u062c\u0627\u0628\u0627\u062a",

  letterPlaceholder:
    "\u0627\u0643\u062a\u0628 \u0627\u0644\u062d\u0631\u0641",

  checkLetter:
    "\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u062d\u0631\u0641",

  writing:
    "\u0645\u0633\u0627\u062d\u0629 \u062a\u062f\u0631\u064a\u0628 \u0627\u0644\u0643\u062a\u0627\u0628\u0629",

  success:
    "\u0623\u062d\u0633\u0646\u062a!",

  retry:
    "\u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649.",

  recorded:
    "\u062a\u0645 \u062a\u0633\u062c\u064a\u0644 \u0625\u0646\u062c\u0627\u0632 \u0627\u0644\u0646\u0634\u0627\u0637.",

  listening:
    "\u0627\u0644\u0627\u0633\u062a\u0645\u0627\u0639",

  speaking:
    "\u0627\u0644\u062a\u062d\u062f\u062b",

  reading:
    "\u0627\u0644\u0642\u0631\u0627\u0621\u0629",

  writingSection:
    "\u0627\u0644\u0643\u062a\u0627\u0628\u0629",

  training:
    "\u0627\u0644\u062a\u062f\u0631\u064a\u0628",

  languageTraining:
    "\u0627\u0644\u062a\u062f\u0631\u064a\u0628 \u0627\u0644\u0644\u063a\u0648\u064a",
};

export default function InteractiveLessonActivities({
  activities,
}: Props) {

  const sorted =
    useMemo(
      () =>
        [...activities].sort(
          (a, b) =>
            a.activity_order -
            b.activity_order
        ),
      [activities]
    );

  const [
    selected,
    setSelected,
  ] =
    useState<
      Record<string, string[]>
    >({});

  const [
    matching,
    setMatching,
  ] =
    useState<
      Record<
        string,
        Record<string, string>
      >
    >({});

  const [
    fills,
    setFills,
  ] =
    useState<
      Record<string, string[]>
    >({});

  const [
    letters,
    setLetters,
  ] =
    useState<
      Record<string, string>
    >({});

  const [
    ordered,
    setOrdered,
  ] =
    useState<
      Record<string, string[]>
    >({});

  const [
    results,
    setResults,
  ] =
    useState<
      Record<string, Result>
    >({});

  const [
    loading,
    setLoading,
  ] =
    useState<
      Record<string, boolean>
    >({});

  const [
    errors,
    setErrors,
  ] =
    useState<
      Record<string, string>
    >({});


  function clear(
    id: string
  ) {
    setResults(
      (current) => {
        const next = {
          ...current,
        };

        delete next[id];

        return next;
      }
    );

    setErrors(
      (current) => ({
        ...current,
        [id]: "",
      })
    );
  }


  async function submit(
    activityId: string,
    answer: string[]
  ) {

    const clean =
      answer.filter(Boolean);

    if (
      clean.length === 0
    ) {
      setErrors(
        (current) => ({
          ...current,
          [activityId]:
            T.completeFirst,
        })
      );

      return;
    }

    setLoading(
      (current) => ({
        ...current,
        [activityId]:
          true,
      })
    );

    setErrors(
      (current) => ({
        ...current,
        [activityId]:
          "",
      })
    );

    try {

      const response =
        await fetch(
          "/api/lesson-activities/check",
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json",
            },

            body:
              JSON.stringify({
                activityId,
                answer:
                  clean,
              }),
          }
        );

      const text =
        await response.text();

      let data:
        ApiResult;

      try {
        data =
          JSON.parse(
            text
          ) as ApiResult;
      } catch {
        throw new Error(
          "Invalid server response."
        );
      }

      if (
        !response.ok ||
        !data.success
      ) {
        throw new Error(
          data.message ??
          "Activity request failed."
        );
      }

      setResults(
        (current) => ({
          ...current,

          [activityId]: {
            correct:
              Boolean(
                data.correct
              ),

            earnedPoints:
              Number(
                data.earnedPoints ??
                0
              ),

            maxPoints:
              Number(
                data.maxPoints ??
                0
              ),

            completionOnly:
              data.completionOnly,

            progressPercent:
              data.progressPercent,

            lessonScore:
              data.lessonScore,
          },
        })
      );

    } catch (error) {

      setErrors(
        (current) => ({
          ...current,

          [activityId]:
            error instanceof Error
              ? error.message
              : "Request failed.",
        })
      );

    } finally {

      setLoading(
        (current) => ({
          ...current,
          [activityId]:
            false,
        })
      );
    }
  }


  const progressValues =
    Object.values(
      results
    )
      .map(
        (result) =>
          result.progressPercent
      )
      .filter(
        (
          value
        ): value is number =>
          typeof value === "number"
      );

  const latestProgress =
    progressValues.length > 0
      ? progressValues[
          progressValues.length - 1
        ]
      : null;


  return (
    <section className="rounded-3xl bg-white p-6 shadow-sm">

      <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">

        <div>
          <p className="text-sm font-black text-violet-700">
            {"\ud83c\udfae"} {T.activities}
          </p>

          <h2 className="mt-1 text-2xl font-black text-slate-900">
            {T.train}
          </h2>
        </div>

        <div className="flex flex-wrap gap-2">

          <span className="rounded-full bg-violet-50 px-4 py-2 text-sm font-black text-violet-700">
            {sorted.length} {T.activity}
          </span>

          {latestProgress !== null ? (
            <span className="rounded-full bg-sky-50 px-4 py-2 text-sm font-black text-sky-700">
              {T.progress}: {latestProgress}%
            </span>
          ) : null}

        </div>
      </div>


      <div className="mt-6 space-y-5">

        {sorted.map(
          (
            activity,
            index
          ) => {

            const content =
              activity.content ?? {};

            const imageUrl =
              typeof content.image_url === "string"
                ? content.image_url
                : null;

          const audioText =
            typeof content.audio_text === "string"
              ? content.audio_text
              : null;

          const audioUrl =
            typeof content.audio_url === "string"
              ? content.audio_url
              : null;

            const options =
              strings(
                content.options
              );

            const words =
              strings(
                content.words
              );

            const questions =
              strings(
                content.questions
              );

            const examples =
              strings(
                content.examples
              );

            const left =
              strings(
                content.left
              );

            const right =
              strings(
                content.right
              );

            const items =
              getFillItems(
                content.items
              );

            const answer =
              selected[
                activity.id
              ] ?? [];

            const match =
              matching[
                activity.id
              ] ?? {};

            const fill =
              fills[
                activity.id
              ] ?? [];

            const letter =
              letters[
                activity.id
              ] ?? "";

            const order =
              ordered[
                activity.id
              ] ?? [];

            const result =
              results[
                activity.id
              ];

            const error =
              errors[
                activity.id
              ];

            const busy =
              loading[
                activity.id
              ] ?? false;


            const hasOptions =
              options.length > 0;

            const hasMatching =
              activity.activity_type ===
                "matching" &&
              left.length > 0 &&
              right.length > 0;

            const hasOrdering =
              activity.activity_type ===
                "matching" &&
              words.length > 0 &&
              left.length === 0;

            const hasFill =
              activity.activity_type ===
                "fill_blank" &&
              items.length > 0;

            const hasLetter =
              activity.activity_type ===
                "fill_blank" &&
              items.length === 0 &&
              words.length > 0;

            const completionOnly =
              !hasOptions &&
              !hasMatching &&
              !hasOrdering &&
              !hasFill &&
              !hasLetter;


            const section =
              activity.section ||
              (
                activity.activity_type ===
                "listening"
                  ? T.listening

                  : activity.activity_type ===
                      "speaking"
                    ? T.speaking

                    : activity.activity_type ===
                        "reading"
                      ? T.reading

                      : activity.activity_type ===
                          "writing"
                        ? T.writingSection

                        : activity.activity_type ===
                            "matching"
                          ? T.training

                          : activity.activity_type ===
                              "fill_blank"
                            ? T.languageTraining

                            : T.activity
              );


            return (
              <article
                key={activity.id}
                className="rounded-2xl border border-slate-200 bg-slate-50 p-5"
              >

                <div className="flex gap-4">

                  <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-violet-600 text-sm font-black text-white">
                    {index + 1}
                  </span>

                  <div className="min-w-0 flex-1">

                    <div className="flex flex-wrap items-center gap-2">

                      <span className="rounded-full bg-violet-100 px-3 py-1 text-xs font-black text-violet-700">
                        {section}
                      </span>

                      <span className="rounded-full bg-white px-3 py-1 text-xs font-bold text-slate-500 ring-1 ring-slate-200">
                        {activity.points} {T.points}
                      </span>

                    </div>

                    <h3 className="mt-3 text-lg font-black text-slate-900">
                      {activity.title}
                    </h3>

                    {activity.instructions ? (
                      <p className="mt-2 leading-7 text-slate-600">
                        {activity.instructions}
                      </p>
                    ) : null}

                  </div>
                </div>


                                                {audioText ? (
                  <ListenButton
                    text={audioText}
                    audioUrl={audioUrl}
                  />
                ) : null}

{imageUrl ? (
                  <div className="mt-5 overflow-hidden rounded-2xl bg-white p-3 ring-1 ring-slate-200">
                    <img
                      src={imageUrl}
                      alt={activity.title}
                      className="mx-auto max-h-[520px] w-auto rounded-xl object-contain"
                    />
                  </div>
                ) : null}

{questions.length > 0 ? (
                  <div className="mt-5 space-y-2 rounded-xl bg-white p-4 ring-1 ring-slate-200">
                    {questions.map(
                      (
                        question,
                        questionIndex
                      ) => (
                        <p
                          key={`${activity.id}-q-${questionIndex}`}
                          className="leading-7 text-slate-700"
                        >
                          {questionIndex + 1}. {question}
                        </p>
                      )
                    )}
                  </div>
                ) : null}


                {examples.length > 0 ? (
                  <div className="mt-5 flex flex-wrap gap-2">
                    {examples.map(
                      (
                        example,
                        exampleIndex
                      ) => (
                        <span
                          key={`${activity.id}-example-${exampleIndex}`}
                          className="rounded-xl bg-violet-50 px-4 py-2 text-lg font-black text-violet-800"
                        >
                          {example}
                        </span>
                      )
                    )}
                  </div>
                ) : null}


                {hasOptions ? (
                  <div className="mt-5">

                    <div className="grid gap-3 sm:grid-cols-2">

                      {options.map(
                        (
                          option,
                          optionIndex
                        ) => {

                          const multi =
                            options.length > 3;

                          const active =
                            answer.includes(
                              option
                            );

                          return (
                            <button
                              key={`${activity.id}-option-${optionIndex}`}
                              type="button"
                              onClick={() => {

                                clear(
                                  activity.id
                                );

                                setSelected(
                                  (current) => {

                                    const old =
                                      current[
                                        activity.id
                                      ] ?? [];

                                    if (
                                      !multi
                                    ) {
                                      return {
                                        ...current,
                                        [activity.id]:
                                          [option],
                                      };
                                    }

                                    return {
                                      ...current,

                                      [activity.id]:
                                        old.includes(
                                          option
                                        )
                                          ? old.filter(
                                              (item) =>
                                                item !==
                                                option
                                            )
                                          : [
                                              ...old,
                                              option,
                                            ],
                                    };
                                  }
                                );
                              }}
                              className={
                                "rounded-xl border px-4 py-3 text-right font-bold transition " +
                                (
                                  active
                                    ? "border-violet-500 bg-violet-100 text-violet-900"
                                    : "border-slate-200 bg-white text-slate-700 hover:border-violet-300 hover:bg-violet-50"
                                )
                              }
                            >
                              {option}
                            </button>
                          );
                        }
                      )}

                    </div>

                    <button
                      type="button"
                      disabled={busy}
                      onClick={() =>
                        submit(
                          activity.id,
                          answer
                        )
                      }
                      className="mt-4 rounded-xl bg-violet-600 px-5 py-3 font-black text-white disabled:opacity-60"
                    >
                      {busy
                        ? T.checking
                        : T.check}
                    </button>

                  </div>
                ) : null}


                {hasMatching ? (
                  <div className="mt-5 space-y-4">

                    {left.map(
                      (
                        leftValue,
                        leftIndex
                      ) => (
                        <div
                          key={`${activity.id}-match-${leftIndex}`}
                          className="grid gap-3 rounded-xl bg-white p-4 ring-1 ring-slate-200 sm:grid-cols-2"
                        >

                          <div className="font-bold text-slate-800">
                            {leftValue}
                          </div>

                          <select
                            value={
                              match[
                                leftValue
                              ] ?? ""
                            }
                            onChange={(event) => {

                              clear(
                                activity.id
                              );

                              setMatching(
                                (current) => ({
                                  ...current,

                                  [activity.id]: {
                                    ...(
                                      current[
                                        activity.id
                                      ] ?? {}
                                    ),

                                    [leftValue]:
                                      event.target.value,
                                  },
                                })
                              );
                            }}
                            className="rounded-xl border border-slate-300 bg-white px-3 py-2 font-bold"
                          >

                            <option value="">
                              {T.chooseMatch}
                            </option>

                            {right.map(
                              (
                                rightValue,
                                rightIndex
                              ) => (
                                <option
                                  key={`${activity.id}-${leftIndex}-${rightIndex}`}
                                  value={
                                    rightValue
                                  }
                                >
                                  {rightValue}
                                </option>
                              )
                            )}

                          </select>

                        </div>
                      )
                    )}

                    <button
                      type="button"
                      disabled={busy}
                      onClick={() =>
                        submit(
                          activity.id,
                          left.map(
                            (leftValue) => {
                              const rightValue =
                                match[
                                  leftValue
                                ];

                              return rightValue
                                ? `${leftValue}|||${rightValue}`
                                : "";
                            }
                          )
                        )
                      }
                      className="rounded-xl bg-violet-600 px-5 py-3 font-black text-white disabled:opacity-60"
                    >
                      {T.checkMatch}
                    </button>

                  </div>
                ) : null}


                {hasOrdering ? (
                  <div className="mt-5">

                    <p className="mb-3 font-black text-slate-600">
                      {T.orderedPrompt}
                    </p>

                    <div className="flex flex-wrap gap-2">

                      {[...words]
                        .reverse()
                        .map(
                          (
                            word,
                            wordIndex
                          ) => (
                            <button
                              key={`${activity.id}-word-${wordIndex}`}
                              type="button"
                              onClick={() => {

                                clear(
                                  activity.id
                                );

                                setOrdered(
                                  (current) => ({
                                    ...current,

                                    [activity.id]: [
                                      ...(
                                        current[
                                          activity.id
                                        ] ?? []
                                      ),
                                      word,
                                    ],
                                  })
                                );
                              }}
                              className="rounded-xl bg-white px-4 py-2 font-black text-slate-800 ring-1 ring-slate-200"
                            >
                              {word}
                            </button>
                          )
                        )}

                    </div>

                    <div className="mt-4 min-h-14 rounded-xl border-2 border-dashed border-violet-200 bg-white p-4 font-bold">
                      {order.length > 0
                        ? order.join(" \u2190 ")
                        : T.emptyOrder}
                    </div>

                    <div className="mt-3 flex gap-2">

                      <button
                        type="button"
                        onClick={() => {

                          clear(
                            activity.id
                          );

                          setOrdered(
                            (current) => ({
                              ...current,
                              [activity.id]:
                                [],
                            })
                          );
                        }}
                        className="rounded-xl bg-slate-200 px-4 py-2 font-bold text-slate-700"
                      >
                        {T.reset}
                      </button>

                      <button
                        type="button"
                        disabled={busy}
                        onClick={() =>
                          submit(
                            activity.id,
                            order
                          )
                        }
                        className="rounded-xl bg-violet-600 px-5 py-2 font-black text-white disabled:opacity-60"
                      >
                        {T.checkOrder}
                      </button>

                    </div>

                  </div>
                ) : null}


                {hasFill ? (
                  <div className="mt-5 space-y-4">

                    {items.map(
                      (
                        item,
                        itemIndex
                      ) => (
                        <div
                          key={`${activity.id}-fill-${itemIndex}`}
                          className="rounded-xl bg-white p-4 ring-1 ring-slate-200"
                        >

                          <p className="mb-3 font-black text-slate-800">
                            {item.sentence}
                          </p>

                          <div className="flex flex-wrap gap-2">

                            {item.options.map(
                              (
                                option,
                                optionIndex
                              ) => {

                                const active =
                                  fill[
                                    itemIndex
                                  ] ===
                                  option;

                                return (
                                  <button
                                    key={`${activity.id}-${itemIndex}-${optionIndex}`}
                                    type="button"
                                    onClick={() => {

                                      clear(
                                        activity.id
                                      );

                                      setFills(
                                        (current) => {

                                          const next = [
                                            ...(
                                              current[
                                                activity.id
                                              ] ?? []
                                            ),
                                          ];

                                          next[
                                            itemIndex
                                          ] =
                                            option;

                                          return {
                                            ...current,
                                            [activity.id]:
                                              next,
                                          };
                                        }
                                      );
                                    }}
                                    className={
                                      "rounded-xl border px-4 py-2 font-bold " +
                                      (
                                        active
                                          ? "border-violet-500 bg-violet-100 text-violet-900"
                                          : "border-slate-200 bg-white text-slate-700"
                                      )
                                    }
                                  >
                                    {option}
                                  </button>
                                );
                              }
                            )}

                          </div>
                        </div>
                      )
                    )}

                    <button
                      type="button"
                      disabled={busy}
                      onClick={() =>
                        submit(
                          activity.id,
                          fill
                        )
                      }
                      className="rounded-xl bg-violet-600 px-5 py-3 font-black text-white disabled:opacity-60"
                    >
                      {T.checkAnswers}
                    </button>

                  </div>
                ) : null}


                {hasLetter ? (
                  <div className="mt-5">

                    <div className="flex flex-wrap gap-2">

                      {words.map(
                        (
                          word,
                          wordIndex
                        ) => (
                          <span
                            key={`${activity.id}-letter-word-${wordIndex}`}
                            className="rounded-xl bg-white px-4 py-2 font-black text-slate-800 ring-1 ring-slate-200"
                          >
                            {word}
                          </span>
                        )
                      )}

                    </div>

                    <input
                      value={letter}
                      maxLength={1}
                      placeholder={
                        T.letterPlaceholder
                      }
                      onChange={(event) => {

                        clear(
                          activity.id
                        );

                        setLetters(
                          (current) => ({
                            ...current,
                            [activity.id]:
                              event.target.value,
                          })
                        );
                      }}
                      className="mt-4 w-40 rounded-xl border border-slate-300 px-4 py-3 text-center text-3xl font-black"
                    />

                    <button
                      type="button"
                      disabled={busy}
                      onClick={() =>
                        submit(
                          activity.id,
                          letter
                            ? [letter]
                            : []
                        )
                      }
                      className="mt-4 block rounded-xl bg-violet-600 px-5 py-3 font-black text-white disabled:opacity-60"
                    >
                      {T.checkLetter}
                    </button>

                  </div>
                ) : null}


                {activity.activity_type === "writing" ? (
  <div className="mt-5">
    <HandwritingCanvas
      letter={
        typeof content.letter === "string"
          ? content.letter
          : "\u0628"
      }
    />
  </div>
) : null}


                {completionOnly ? (
                  <button
                    type="button"
                    disabled={
                      busy ||
                      result?.correct
                    }
                    onClick={() =>
                      submit(
                        activity.id,
                        [
                          "__completed__",
                        ]
                      )
                    }
                    className="mt-5 rounded-xl bg-emerald-600 px-5 py-3 font-black text-white disabled:opacity-60"
                  >
                    {result?.correct
                      ? "\u2705 " +
                        T.completed
                      : T.markComplete}
                  </button>
                ) : null}


                {result ? (
                  <div
                    className={
                      "mt-4 rounded-xl p-4 font-black " +
                      (
                        result.correct
                          ? "bg-emerald-50 text-emerald-700"
                          : "bg-rose-50 text-rose-700"
                      )
                    }
                  >

                    {result.correct
                      ? result.completionOnly
                        ? "\u2705 " +
                          T.recorded
                        : "\u2705 " +
                          T.success +
                          ` ${result.earnedPoints}/${result.maxPoints}`
                      : "\u274c " +
                        T.retry}

                    {typeof result.progressPercent ===
                    "number" ? (
                      <div className="mt-2 text-sm">
                        {T.progress}:{" "}
                        {result.progressPercent}%
                      </div>
                    ) : null}

                  </div>
                ) : null}


                {error ? (
                  <p className="mt-3 font-bold text-rose-600">
                    {error}
                  </p>
                ) : null}

              </article>
            );
          }
        )}

      </div>
    </section>
  );
}
