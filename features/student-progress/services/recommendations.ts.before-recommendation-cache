import { logger } from "@/lib/logger";
import { createClient } from "@/lib/supabase/server";

export type RecommendedLesson = {
  id: string;
  title: string;
  lesson_number: number;
};

export async function getRecommendedLessons(
  studentId: string,
  targetSkill?: string
): Promise<RecommendedLesson[]> {
  const supabase = await createClient();

  const { data: progress, error: progressError } = await supabase
    .from("student_lesson_progress")
    .select("lesson_id")
    .eq("student_id", studentId);

  if (progressError) {
    throw progressError;
  }

  const startedLessonIds =
    progress?.map((item) => item.lesson_id) ?? [];

  let lessonIds: string[] | null = null;

  if (targetSkill) {
    const { data: skills, error: skillsError } =
      await supabase
        .from("lesson_skills")
        .select("lesson_id")
        .eq("skill", targetSkill);

    if (skillsError) {
      throw skillsError;
    }

    lessonIds =
      skills?.map((item) => item.lesson_id) ?? [];

    if (lessonIds.length === 0) {
      logger.info(
        "SMART_RECOMMENDATIONS_NO_SKILL_LESSON",
        {
          targetSkill,
        }
      );

      return [];
    }

    logger.info(
      "SMART_RECOMMENDATIONS_SKILL_MATCH",
      {
        targetSkill,
        lessonIds,
      }
    );
  }

  let query = supabase
    .from("lessons")
    .select(`
      id,
      title,
      lesson_number
    `)
    .eq("status", "published")
    .order("lesson_number");

  if (lessonIds) {
    query = query.in("id", lessonIds);
  }

  if (startedLessonIds.length > 0) {
    query = query.not(
      "id",
      "in",
      `(${startedLessonIds.join(",")})`
    );
  }

  const { data, error } = await query.limit(5);

  if (error) {
    throw error;
  }

  return (data ?? []) as RecommendedLesson[];
}