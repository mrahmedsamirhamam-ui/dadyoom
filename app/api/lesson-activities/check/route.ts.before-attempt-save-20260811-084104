import { NextResponse } from "next/server";
import { createClient } from "@/lib/supabase/server";

type RequestBody = {
  activityId?: string;
  answer?: string[];
};

function normalizeStrings(value: unknown): string[] {
  return Array.isArray(value)
    ? value.filter(
        (item): item is string =>
          typeof item === "string"
      )
    : [];
}

export async function POST(request: Request) {
  try {
    const body =
      (await request.json()) as RequestBody;

    const activityId =
      typeof body.activityId === "string"
        ? body.activityId.trim()
        : "";

    const studentAnswer =
      normalizeStrings(body.answer)
        .map((item) => item.trim())
        .filter(Boolean);

    if (!activityId) {
      return NextResponse.json(
        {
          success: false,
          message: "معرّف النشاط غير موجود.",
        },
        { status: 400 }
      );
    }

    const supabase =
      await createClient();

    const {
      data: { user },
    } =
      await supabase.auth.getUser();

    if (!user) {
      return NextResponse.json(
        {
          success: false,
          message: "سجّل الدخول أولًا لحفظ نتيجة النشاط.",
        },
        { status: 401 }
      );
    }

    const {
      data: activity,
      error,
    } =
      await supabase
        .from("lesson_activities")
        .select(
          "id,activity_type,answer,points,is_published"
        )
        .eq("id", activityId)
        .eq("is_published", true)
        .maybeSingle();

    if (error) {
      throw error;
    }

    if (!activity) {
      return NextResponse.json(
        {
          success: false,
          message: "النشاط غير موجود.",
        },
        { status: 404 }
      );
    }

    const answerData =
      activity.answer &&
      typeof activity.answer === "object"
        ? (activity.answer as Record<string, unknown>)
        : {};

    const rawCorrect =
      answerData.correct;

    const correctAnswers =
      typeof rawCorrect === "string"
        ? [rawCorrect]
        : normalizeStrings(rawCorrect);

    const normalizedCorrect =
      [...correctAnswers]
        .map((item) => item.trim())
        .sort();

    const normalizedStudent =
      [...studentAnswer]
        .map((item) => item.trim())
        .sort();

    const isCorrect =
      normalizedCorrect.length > 0 &&
      normalizedCorrect.length ===
        normalizedStudent.length &&
      normalizedCorrect.every(
        (value, index) =>
          value === normalizedStudent[index]
      );

    const maxPoints =
      Number(activity.points ?? 0);

    return NextResponse.json({
      success: true,
      correct: isCorrect,
      earnedPoints:
        isCorrect ? maxPoints : 0,
      maxPoints,
    });

  } catch (error) {
    console.error(
      "Activity checking error:",
      error
    );

    return NextResponse.json(
      {
        success: false,
        message: "تعذر تصحيح النشاط.",
      },
      { status: 500 }
    );
  }
}
