# Dadyoom production environment template — NEVER place real secrets in Git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODELS_PRIORITY=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
NEXT_PUBLIC_SITE_URL=

# Optional fallbacks / specialized AI models
GEMINI_API_KEY_BACKUP=
GEMINI_MODEL_BACKUP=
GEMINI_EMBEDDING_MODEL=
GEMINI_GRADING_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=


# Cinematic two-avatar lesson videos (server-side only)
# Create the key in HeyGen Developers. Never expose it in client code or commit a real value.
HEYGEN_API_KEY=
HEYGEN_VIDEO_STYLE_ID=
HEYGEN_BRAND_KIT_ID=


# Avatar video provider failover (free providers first; paid providers are opt-in)
ALLOW_PAID_VIDEO_PROVIDERS=false
# Default order: free/free-start capacity first, then paid fallbacks.
VIDEO_PROVIDER_ORDER=hf-ltx23,hf-minimax-h3,hf-minimax-h3-hq,hf-wan22,hf-ltx,hf-sadtalker,hf-musetalk,higgsfield,heygen,tavus,akool,did,creatify

# Tavus — free developer tier includes async video-generation minutes
TAVUS_API_KEY=
TAVUS_REPLICA_ID=

# AKOOL — signup credits / talking-avatar API
AKOOL_API_KEY=
AKOOL_AVATAR_ID=
AKOOL_VOICE_ID=

# D-ID — trial/API talking photo fallback
DID_API_KEY=
DID_SOURCE_IMAGE_URL=
DID_VOICE_ID=

# Creatify — multi-avatar API (only used when API credentials are available)
CREATIFY_API_ID=
CREATIFY_API_KEY=
CREATIFY_AVATAR_A_ID=
CREATIFY_AVATAR_B_ID=
CREATIFY_VOICE_A_ID=
CREATIFY_VOICE_B_ID=

# Hugging Face ZeroGPU text-to-video provider.
# Uses the caller account's renewable ZeroGPU quota through HF_TOKEN.
HF_TOKEN=
HF_LTX23_BASE_URL=https://lightricks-ltx-2-3.hf.space
HF_LTX23_DURATION=5
HF_LTX23_HEIGHT=1024
HF_LTX23_WIDTH=1536
ENABLE_H3_HQ_VIDEO=false
HF_MINIMAX_H3_HQ_BASE_URL=https://multimodalart-minimax-h3.hf.space
HF_MINIMAX_H3_HQ_CANVAS=1280x704 · 16:9
HF_MINIMAX_H3_HQ_DURATION=5
HF_MINIMAX_H3_HQ_STEPS=28
HF_MINIMAX_H3_BASE_URL=https://minimaxai-minimax-h3-turbo-lora.hf.space
HF_MINIMAX_H3_CANVAS=1344x768 · 16:9 full
HF_MINIMAX_H3_DURATION=5
HF_MINIMAX_H3_STEPS=6
ENABLE_WAN22_VIDEO_FALLBACK=false
HF_WAN22_BASE_URL=https://wan-ai-wan-2-2-5b.hf.space
ENABLE_LTX_VIDEO_FALLBACK=false
HF_LTX_BASE_URL=https://lightricks-ltx-video-distilled.hf.space
HF_LTX_HEIGHT=512
HF_LTX_WIDTH=704
HF_LTX_DURATION=2

# Hugging Face/open-source emergency gateways.
# Point these at Dadyoom-owned wrappers around a ZeroGPU SadTalker/MuseTalk Space.
HF_SADTALKER_GATEWAY_URL=
HF_MUSETALK_GATEWAY_URL=
HF_TEACHER_IMAGE_URL=
HF_STUDENT_IMAGE_URL=

# Multi-provider AI router. Configured providers automatically fail over.
AI_PROVIDER_ORDER=gemini,deepseek,openrouter,anthropic,groq,mistral,openai,ollama
AI_QUALITY_PROVIDER_ORDER=anthropic,gemini,deepseek,openrouter,groq,mistral,openai,ollama
AI_TIMEOUT_MS=45000
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# Higgsfield server-side video API.
# Use either HIGGSFIELD_CREDENTIALS=KEY_ID:KEY_SECRET
# or the separate KEY_ID / KEY_SECRET variables below.
HIGGSFIELD_CREDENTIALS=
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
HIGGSFIELD_VIDEO_MODEL=bytedance/seedance-2.5/text-to-video
HIGGSFIELD_VIDEO_DURATION=8
HIGGSFIELD_VIDEO_RESOLUTION=720p
HIGGSFIELD_VIDEO_GENERATE_AUDIO=true
